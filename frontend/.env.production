# Public, non-secret build settings for the hosted site (worldofsports.tech).
# Live world state comes from SpacetimeDB Maincloud; set the database name after publishing.
VITE_SPACETIME_URI=wss://maincloud.spacetimedb.com
VITE_SPACETIME_DB=sportsworld
VITE_WS_BASE=wss://sportsworld-api.onrender.com
VITE_SPACETIME_ENABLED=false
