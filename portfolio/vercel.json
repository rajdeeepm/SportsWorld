{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" }
    ] }
  ],
  "redirects": [
    { "source": "/:path*", "has": [{"type":"host","value":"www.worldofsports.tech"}], "destination": "https://worldofsports.tech/:path*", "permanent": true },
    { "source": "/nfl/:path*", "destination": "/#explorer", "permanent": true },
    { "source": "/college-football/:path*", "destination": "/#explorer", "permanent": true },
    { "source": "/research", "destination": "/#research", "permanent": true }
  ]
}
